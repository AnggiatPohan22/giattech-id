# ═══════════════════════════════════════════════════════════════
#  GIATTECH — Central Site Configuration
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to `.env` (root) and fill in real values.
# Every PUBLIC_* value is baked into the static build at
# `npm run build` — after editing .env you MUST rebuild for
# changes to reach production.
#
#   cp .env.example .env      # once, first time
#   # edit .env
#   npm run build             # rebuild → dist/
#
# The .env file is git-ignored — production values never leave
# your machine unless you copy them to Hostinger's env panel.
# ═══════════════════════════════════════════════════════════════

# ─── Site identity ─────────────────────────────────────────────
PUBLIC_SITE_NAME="Giattech"
PUBLIC_SITE_TAGLINE="Web Application Studio"
PUBLIC_SITE_URL="https://giattech.com"
PUBLIC_SITE_DESCRIPTION="Digital agency building high-performance web applications with Laravel, modern frontend, and AI-assisted development."

# ─── SEO — Open Graph & Twitter card ───────────────────────────
# Path (from public/) to the share image, ideally 1200×630.
PUBLIC_OG_IMAGE="/images/og-image.jpg"

# ─── Contact ───────────────────────────────────────────────────
PUBLIC_EMAIL="hello@giattech.com"

# WhatsApp number in E.164 format — digits only, no +, no spaces
# Example Indonesia: 6281234567890  (drop the leading 0 from 08…)
PUBLIC_WHATSAPP_NUMBER="6281234567890"
PUBLIC_WHATSAPP_MESSAGE="Hi Giattech, I'd like to discuss a project."

# ─── Social media ──────────────────────────────────────────────
# Leave empty to hide a link from the footer / sidebar / hero nav
PUBLIC_LINKEDIN_URL="https://www.linkedin.com/"
PUBLIC_TWITTER_URL="https://x.com/"
PUBLIC_GITHUB_URL="https://github.com/AnggiatPohan22"
PUBLIC_INSTAGRAM_URL=""

# ─── Analytics (optional) ──────────────────────────────────────
# Set a value to enable Google Analytics 4. Leave empty to skip.
PUBLIC_GA_MEASUREMENT_ID=""

# Set a value to enable Plausible analytics. Leave empty to skip.
PUBLIC_PLAUSIBLE_DOMAIN=""
