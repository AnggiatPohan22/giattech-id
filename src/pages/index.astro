---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import SidebarNav from '../components/sections/SidebarNav.astro';
import Footer from '../components/sections/Footer.astro';
import { sidebarSections } from '../data/navigation';

const sectionTitles: Record<(typeof sidebarSections)[number], string> = {
  hero: 'Hero',
  about: 'About',
  services: 'Services',
  projects: 'Projects',
  pricing: 'Pricing',
  testimonials: 'Testimonials',
  faq: 'FAQ',
};
---

<Layout>
  <Navbar />
  <SidebarNav />

  <main>
    {
      sidebarSections.map((id, i) => (
        <section
          id={id}
          data-section={id}
          class="container-page section-y min-h-[80vh] flex flex-col justify-center border-b border-[color:var(--color-border)]"
        >
          <span class="text-eyebrow mb-4">Placeholder / Section {i + 1}</span>
          <h2 class="text-h2 font-display font-bold">{sectionTitles[id]}</h2>
          <p class="mt-4 text-body text-[color:var(--color-text-muted)] max-w-2xl">
            This section will be built in a later phase. Content, layout, and
            animation live in the tasks tracked in CLAUDE.md.
          </p>
        </section>
      ))
    }

    <section
      id="cta"
      data-section="cta"
      class="container-page section-y min-h-[60vh] flex flex-col justify-center"
    >
      <span class="text-eyebrow mb-4">Placeholder / CTA</span>
      <h2 class="text-h2 font-display font-bold">CTA</h2>
      <p class="mt-4 text-body text-[color:var(--color-text-muted)] max-w-2xl">
        Final assembly in T30 will replace these placeholders with the real
        section components.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
