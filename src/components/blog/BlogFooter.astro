---
/**
 * BlogFooter — deep obsidian block closing every blog page.
 *
 * Keeps a dense set of internal links back to both the blog's own
 * hubs and the main giattech.com sections — that cross-linking is
 * the whole point of the blog.
 */
import { blogCategories, type BlogLang } from '../../data/blog-categories';
import { routes, t } from '../../data/blog-i18n';
import { site, contact } from '../../config/site';
import { socialLinks } from '../../data/navigation';

interface Props {
  lang: BlogLang;
}

const { lang } = Astro.props;
const copy = t[lang];
const year = new Date().getFullYear();

// Deep links into the single-page main site — the strongest internal
// links the blog can hand upstream.
const mainLinks = lang === 'id'
  ? [
      { label: 'Beranda Giattech', href: '/' },
      { label: 'Tentang Kami',     href: '/#about' },
      { label: 'Layanan',          href: '/#services' },
      { label: 'Portofolio',       href: '/#projects' },
      { label: 'Harga',            href: '/#pricing' },
      { label: 'Hubungi Kami',     href: '/#cta' },
    ]
  : [
      { label: 'Giattech Home', href: '/' },
      { label: 'About',         href: '/#about' },
      { label: 'Services',      href: '/#services' },
      { label: 'Projects',      href: '/#projects' },
      { label: 'Pricing',       href: '/#pricing' },
      { label: 'Contact',       href: '/#cta' },
    ];

const exploreLinks = [
  { label: copy.nav.home,    href: routes.home(lang) },
  { label: copy.nav.about,   href: routes.about(lang) },
  { label: copy.nav.tools,   href: routes.tools(lang) },
  { label: copy.nav.archive, href: routes.archive(lang) },
];

const icons: Record<string, string> = {
