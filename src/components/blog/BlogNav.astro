---
/**
 * BlogNav — light glass bar over the bone-white page.
 *
 * Menu per the brief: Home · Content ▾ · About Blog · Tools · Archive,
 * plus the language switch, an inline search field, and a solid
 * obsidian "Hubungi Kami" button that goes back to giattech.com.
 */
import { blogCategories, type BlogLang } from '../../data/blog-categories';
import { routes, t, otherLang, langShort, langNames } from '../../data/blog-i18n';
import { site } from '../../config/site';
import Icon from './Icon.astro';

interface Props {
  lang: BlogLang;
  active?: 'home' | 'content' | 'about' | 'tools' | 'archive';
  /** Same page in the other language; falls back to that language's blog home */
  altPath?: string;
}

const { lang, active, altPath } = Astro.props;
const copy = t[lang];
const other = otherLang(lang);
const otherHref = altPath ?? routes.home(other);

const items = [
  { key: 'home',    label: copy.nav.home,    href: routes.home(lang) },
  { key: 'about',   label: copy.nav.about,   href: routes.about(lang) },
  { key: 'tools',   label: copy.nav.tools,   href: routes.tools(lang) },
  { key: 'archive', label: copy.nav.archive, href: routes.archive(lang) },
] as const;

const ctaLabel = lang === 'id' ? 'Hubungi Kami' : 'Get in Touch';
---

<header
  class="bl-nav"
  data-blog-nav
  x-data="{ content: false, mobile: false }"
  @keydown.escape.window="content = false; mobile = false"
>
  <div class="bl-container">
    <div class="flex items-center justify-between gap-4 h-16 lg:h-20">
      <!-- Wordmark: sits on the light nav → navy variant -->
      <a href={routes.home(lang)} class="flex items-center shrink-0" aria-label={`${site.name} ${copy.brandSuffix}`}>
        <img
          src="/images/navy-logo-giattech-2.png"
          alt={`${site.name} ${copy.brandSuffix}`}
          width="457"
          height="151"
          class="h-7 lg:h-8 w-auto"
          decoding="async"
        />
      </a>

      <!-- Desktop menu -->
      <nav class="hidden lg:flex items-center gap-8" aria-label={copy.brandSuffix}>
        <a
          href={items[0].href}
          class="bl-nav-link"
          aria-current={active === 'home' ? 'page' : undefined}>{items[0].label}</a
        >

        {/* Click to toggle — hover-open plus click-toggle fight each
            other and desync aria-expanded, and hover does nothing on
            touch devices. */}
        <div class="relative" @click.outside="content = false">
          <button
            type="button"
            class="bl-nav-link"
            class:list={[active === 'content' && 'is-active']}
            :aria-expanded="content ? 'true' : 'false'"
            aria-haspopup="true"
            @click="content = !content"
          >
            {copy.nav.content}
            <Icon
              name="chevron-down"
              size={12}
              stroke={2.5}
              class="transition-transform duration-200"
            />
          </button>

          <div x-cloak x-show="content" class="bl-dropdown">
            {
              blogCategories.map((cat) => (
                <a href={routes.category(lang, cat.slug)} class="bl-dropdown-item">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    class="mt-1 shrink-0"
                    style="color: var(--bl-accent);"
                  >
                    <path d={cat.icon} />
                  </svg>
                  <span class="min-w-0">
                    <span class="block bl-body text-[15px] font-medium" style="color: var(--bl-ink);">
                      {cat.label[lang]}
                    </span>
                    <span
                      class="block mt-1 text-[12.5px] leading-snug bl-line-clamp-2"
                      style="color: var(--bl-ink-40);"
                    >
                      {cat.description[lang]}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        {
          items.slice(1).map((item) => (
            <a
              href={item.href}
              class="bl-nav-link"
              aria-current={active === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Right cluster -->
      <div class="flex items-center gap-3 lg:gap-5">
        <!-- Inline search (desktop) — jumps to the archive with the query -->
        <form
          method="get"
          action={routes.archive(lang)}
          class="hidden xl:flex items-center gap-2 w-44"
          role="search"
        >
          <Icon name="search" size={17} class="opacity-40" />
          <label class="sr-only" for="bl-nav-search">{copy.hero.searchPlaceholder}</label>
          <input
            id="bl-nav-search"
            name="q"
            type="search"
            placeholder={copy.hero.searchPlaceholder}
            class="bl-input-line !py-1 !text-[13px]"
          />
        </form>

        <div class="bl-lang" role="group" aria-label={copy.common.switchLang}>
          <a href={routes.home(lang)} aria-current="true" hreflang={lang} title={langNames[lang]}
            >{langShort[lang]}</a
          >
          <a href={otherHref} hreflang={other} title={langNames[other]}>{langShort[other]}</a>
        </div>

        <a
          href="/#cta"
          class="hidden sm:inline-flex bl-btn bl-btn-primary !py-2.5 !px-5 !text-[12px]"
          title={lang === 'id' ? 'Ke situs utama Giattech' : 'Go to the main Giattech site'}
        >
          {ctaLabel}
        </a>

        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 -mr-2"
          style="color: var(--bl-ink);"
          @click="mobile = !mobile"
          :aria-expanded="mobile ? 'true' : 'false'"
          aria-controls="bl-mobile-menu"
          :aria-label={`mobile ? '${copy.nav.close}' : '${copy.nav.menu}'`}
        >
          <span x-show="!mobile"><Icon name="menu" size={22} /></span>
          <span x-cloak x-show="mobile"><Icon name="close" size={22} /></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="bl-mobile-menu"
    x-cloak
    x-show="mobile"
    class="bl-fade lg:hidden border-t max-h-[calc(100dvh-4rem)] overflow-y-auto"
    style="border-color: var(--bl-sand); background: var(--bl-bone);"
  >
    <nav class="bl-container py-6 flex flex-col" aria-label={copy.nav.menu}>
      <form method="get" action={routes.archive(lang)} class="flex items-center gap-2 mb-6" role="search">
        <Icon name="search" size={18} class="opacity-40" />
        <label class="sr-only" for="bl-mobile-search">{copy.hero.searchPlaceholder}</label>
        <input
          id="bl-mobile-search"
          name="q"
          type="search"
          placeholder={copy.hero.searchPlaceholder}
          class="bl-input-line"
        />
      </form>

      <a href={items[0].href} class="bl-nav-link !text-[13px] py-3">{items[0].label}</a>

      <p class="mt-5 mb-2 bl-label-sm" style="color: var(--bl-ink-40);">{copy.nav.content}</p>
      {
        blogCategories.map((cat) => (
          <a href={routes.category(lang, cat.slug)} class="flex items-center gap-3 py-3">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="shrink-0"
              style="color: var(--bl-accent);"
            >
              <path d={cat.icon} />
            </svg>
            <span class="bl-body text-[15px]" style="color: var(--bl-ink);">{cat.label[lang]}</span>
          </a>
        ))
      }

      <div class="my-4 h-px" style="background: var(--bl-sand);"></div>

      {
        items.slice(1).map((item) => (
          <a href={item.href} class="bl-nav-link !text-[13px] py-3">
            {item.label}
          </a>
        ))
      }

      <a href="/#cta" class="bl-btn bl-btn-primary mt-6 w-full">
        {ctaLabel}
        <Icon name="arrow-right" size={15} stroke={2.5} />
      </a>
      <a
        href="/"
        class="mt-3 text-center bl-label-sm py-2"
        style="color: var(--bl-ink-40);">giattech.com</a
      >
    </nav>
  </div>
</header>
