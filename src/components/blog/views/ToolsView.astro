---
/**
 * ToolsView — the curated resource page.
 *
 * Every tool link here is external (target=_blank, rel=nofollow).
 * The full list lives in src/data/blog-tools.ts.
 */
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import AdSlot from '../AdSlot.astro';
import Newsletter from '../Newsletter.astro';
import Icon from '../Icon.astro';
import { toolGroups, freeLabels } from '../../../data/blog-tools';
import { routes, t, otherLang } from '../../../data/blog-i18n';
import type { BlogLang } from '../../../data/blog-categories';
import { site } from '../../../config/site';

interface Props {
  lang: BlogLang;
}

const { lang } = Astro.props;
const copy = t[lang];
const other = otherLang(lang);

const origin = site.url.replace(/\/$/, '');
const path = routes.tools(lang);
const title = `${copy.nav.tools} — ${site.name} ${copy.brandSuffix}`;
const description =
  lang === 'id'
    ? 'Kumpulan tools yang benar-benar kami pakai untuk mengukur performa, mengoptimasi gambar, memeriksa SEO, dan membangun website — dengan catatan kapan masing-masing berguna.'
    : 'The tools we genuinely use to measure performance, optimise images, check SEO, and build websites — with notes on when each one is worth reaching for.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: copy.nav.tools,
    description,
    url: `${origin}${path}`,
    inLanguage: lang === 'id' ? 'id-ID' : 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.common.breadcrumbHome, item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: copy.brandSuffix, item: `${origin}${routes.home(lang)}` },
      { '@type': 'ListItem', position: 3, name: copy.nav.tools, item: `${origin}${path}` },
    ],
  },
];
---

<BlogLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  altPath={routes.tools(other)}
  jsonLd={jsonLd}
  activeNav="tools"
>
  <section class="bl-container pt-6 pb-10 md:pb-14">
    <Breadcrumbs
      class="mb-8"
      items={[
        { label: copy.common.breadcrumbHome, href: '/' },
        { label: copy.brandSuffix, href: routes.home(lang) },
        { label: copy.nav.tools },
      ]}
    />
    <h1 class="bl-display">{copy.nav.tools}</h1>
    <p class="mt-5 max-w-2xl bl-body-lg" style="color: var(--bl-ink-60);">{description}</p>
    <p class="mt-6 bl-label-sm" style="color: var(--bl-ink-40);">
      {
        lang === 'id'
          ? 'Semua tautan di halaman ini menuju situs pihak ketiga dan terbuka di tab baru. Tidak ada tautan afiliasi.'
          : 'Every link on this page goes to a third-party site and opens in a new tab. No affiliate links.'
      }
    </p>
  </section>

  <div class="bl-container">
    <AdSlot slot="blogTop" lang={lang} variant="leaderboard" />
  </div>

  <section class="bl-container py-12 md:py-16 lg:py-20 flex flex-col gap-16 md:gap-20">
    {
      toolGroups.map((group, gi) => {
        // 6 tools per page keeps the 3×2 desktop grid intact. When a
        // group has more than that, slide pagination kicks in.
        const PER_PAGE = 6;
        const paginated = group.tools.length > PER_PAGE;
        const totalPages = Math.max(1, Math.ceil(group.tools.length / PER_PAGE));
        const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
        const gridProps = paginated
          ? {
              'data-paged-grid': group.slug,
              'data-total-pages': totalPages,
              'data-transition': 'slide',
            }
          : {};

        return (
          <div>
            <div class="bl-rule pb-6">
              <h2 class="bl-headline-lg">{group.title[lang]}</h2>
              <p class="mt-3 max-w-2xl bl-body" style="color: var(--bl-ink-60);">
                {group.description[lang]}
              </p>

              {group.article && (
                <a
                  href={routes.post(lang, lang === 'id' ? group.article.id : group.article.en)}
                  class="group mt-4 inline-flex bl-more bl-more-accent"
                >
                  {group.article.label[lang]}
                  <Icon name="arrow-right" size={14} stroke={2.5} />
                </a>
              )}
            </div>

            <ul
              {...gridProps}
              class="mt-8 grid gap-px sm:grid-cols-2 lg:grid-cols-3 bl-flip-grid"
              style="background: var(--bl-sand);"
            >
              {group.tools.map((tool, ti) => {
                const page = paginated ? 1 + Math.floor(ti / PER_PAGE) : 1;
                return (
                  <li
                    data-page={paginated ? page : undefined}
                    hidden={paginated && page !== 1}
                    class="group flex flex-col p-6"
                    style="background: var(--bl-bone);"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="bl-card-title bl-headline-md">
                        <a href={tool.href} target="_blank" rel="noopener noreferrer nofollow">
                          {tool.name}
                        </a>
                      </h3>
                      <span
                        class="shrink-0 bl-label-sm px-2 py-1"
                        style="background: var(--bl-sand); color: var(--bl-ink); border-radius: var(--bl-r);"
                      >
                        {freeLabels[tool.free][lang]}
                      </span>
                    </div>

                    <p class="mt-3 bl-body flex-1" style="color: var(--bl-ink-60);">
                      {tool.note[lang]}
                    </p>

                    <span
                      class="mt-5 pt-4 inline-flex items-center gap-2 bl-label-sm"
                      style="border-top: 1px solid var(--bl-sand); color: var(--bl-ink-40);"
                    >
                      <Icon name="external" size={13} />
                      <span class="normal-case tracking-normal">{tool.host}</span>
                    </span>
                  </li>
                );
              })}
            </ul>

            {paginated && (
              <nav
                data-pager={group.slug}
                class="mt-8 flex flex-wrap items-center justify-center gap-4 md:gap-8"
                aria-label={lang === 'id' ? 'Navigasi halaman tools' : 'Tools pagination'}
              >
                <button
                  type="button"
                  data-page-prev
                  class="group inline-flex items-center gap-2 bl-label"
                  style="color: var(--bl-ink);"
                  disabled
                >
                  <Icon name="arrow-left" size={16} stroke={2} />
                  <span class="hidden sm:inline">
                    {lang === 'id' ? 'Sebelumnya' : 'Previous'}
                  </span>
                </button>

                <ol class="flex items-center gap-4 md:gap-5" role="list">
                  {pageNumbers.map((n) => (
                    <li>
                      <button
                        type="button"
                        data-goto-page={n}
                        class="bl-page-btn bl-label"
                        aria-current={n === 1 ? 'page' : undefined}
                      >
                        {String(n).padStart(2, '0')}
                      </button>
                    </li>
                  ))}
                </ol>

                <button
                  type="button"
                  data-page-next
                  class="group inline-flex items-center gap-2 bl-label"
                  style="color: var(--bl-ink);"
                >
                  <span class="hidden sm:inline">
                    {lang === 'id' ? 'Berikutnya' : 'Next'}
                  </span>
                  <Icon name="arrow-right" size={16} stroke={2} />
                </button>
              </nav>
            )}

            {gi === 1 && (
              <div class="mt-12">
                <AdSlot slot="blogInline" lang={lang} variant="rectangle" />
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  <section class="bl-container pb-16 md:pb-24 flex flex-col gap-10">
    <div class="bl-ink-block p-8 sm:p-10 lg:p-14">
      <h2 class="bl-headline-lg" style="color: var(--bl-bone);">
        {lang === 'id' ? 'Tidak sempat mengurus sendiri?' : "Don't have time to run these yourself?"}
      </h2>
      <p class="mt-4 max-w-2xl bl-body" style="color: rgba(249, 248, 243, 0.6);">
        {
          lang === 'id'
            ? 'Kami menjalankan audit performa dan SEO teknis sebagai bagian dari setiap proyek — dan sebagai pekerjaan terpisah untuk situs yang sudah berjalan.'
            : 'We run performance and technical SEO audits as part of every project — and as standalone work for sites already live.'
        }
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="/#services" class="bl-btn bl-btn-accent">
          {lang === 'id' ? 'Lihat Layanan' : 'See Services'}
          <Icon name="arrow-right" size={15} stroke={2.5} />
        </a>
        <a
          href="/#cta"
          class="bl-btn"
          style="border: 1px solid rgba(249, 248, 243, 0.3); color: var(--bl-bone);">{copy.cta.primary}</a
        >
      </div>
    </div>

    <Newsletter lang={lang} variant="wide" />
    <AdSlot slot="blogBottom" lang={lang} variant="leaderboard" />
  </section>
</BlogLayout>
