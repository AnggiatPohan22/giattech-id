---
/**
 * ArticleView — the blog detail page, either language.
 *
 * Follows ai/reference/detail_artikel_{desktop,mobile}:
 *   md+     full-bleed hero with the title and author row sitting on
 *           the image, then an 8/4 body + sidebar grid, then a
 *           related-articles band on the alt tone
 *   mobile  compact header, inline hero image, prose, share row,
 *           related rail
 *
 * Sidebar order mirrors the reference: search → latest → categories
 * → newsletter (plus the sticky ad unit at the end).
 */
import { render } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import AdSlot from '../AdSlot.astro';
import ShareBar from '../ShareBar.astro';
import TableOfContents from '../TableOfContents.astro';
import ArticleCTA from '../ArticleCTA.astro';
import PostCard from '../PostCard.astro';
import CoverArt from '../CoverArt.astro';
import Newsletter from '../Newsletter.astro';
import Icon from '../Icon.astro';
import {
  readingTime,
  getPosts,
  getRelated,
  getNeighbours,
  getTranslation,
  type Post,
} from '../../../utils/blog';
import { routes, t, formatDate, otherLang } from '../../../data/blog-i18n';
import {
  blogCategories,
  categoryLabel,
  type BlogLang,
  type CategorySlug,
} from '../../../data/blog-categories';
import { site } from '../../../config/site';

interface Props {
  post: Post;
  lang: BlogLang;
}

const { post, lang } = Astro.props;
const { data } = post;
const copy = t[lang];
const other = otherLang(lang);

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTime(post.body ?? '');

const allPosts = await getPosts(lang);
const latest = allPosts.filter((p) => p.id !== post.id).slice(0, 3);
const related = await getRelated(post, 3);
const { prev, next } = await getNeighbours(post);
const translation = await getTranslation(post, other);

const counts = new Map<string, number>();
for (const p of allPosts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);

const origin = site.url.replace(/\/$/, '');
const path = routes.post(lang, data.slug);
const url = `${origin}${path}`;
// Only offer the language switch when the twin actually exists.
const altPath = translation ? routes.post(other, translation.data.slug) : undefined;

const catName = categoryLabel(data.category, lang);
const catPath = routes.category(lang, data.category);
const ogImage = data.cover ?? site.ogImage;

const authorRole = lang === 'id' ? 'Studio Aplikasi Web' : 'Web Application Studio';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    inLanguage: lang === 'id' ? 'id-ID' : 'en',
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
    author: { '@type': 'Organization', name: data.author, url: `${origin}/` },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: { '@type': 'ImageObject', url: `${origin}/images/logo-blue.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: catName,
    keywords: data.tags.join(', '),
    wordCount: (post.body ?? '').trim().split(/\s+/).length,
    image: ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.common.breadcrumbHome, item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: copy.brandSuffix, item: `${origin}${routes.home(lang)}` },
      { '@type': 'ListItem', position: 3, name: catName, item: `${origin}${catPath}` },
      { '@type': 'ListItem', position: 4, name: data.title, item: url },
    ],
  },
];
---

<BlogLayout
  lang={lang}
  title={`${data.title} — ${site.name} ${copy.brandSuffix}`}
  description={data.description}
  path={path}
  altPath={altPath}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  activeNav="content"
  progressBar
>
  <article>
    {/* ══════════════ Breadcrumb strip ══════════════ */}
    <div class="bl-container pt-6 pb-5">
      <Breadcrumbs
        items={[
          { label: copy.common.breadcrumbHome, href: '/' },
          { label: copy.brandSuffix, href: routes.home(lang) },
          { label: catName, href: catPath },
          { label: data.title },
        ]}
      />
    </div>

    {/* ══════════════ Hero ══════════════ */}
    <header class="bl-hero">
      <div class="bl-hero-media">
        {
          data.cover ? (
            <img
              src={data.cover}
              alt={data.coverAlt ?? data.title}
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <CoverArt
              seed={data.slug}
              category={data.category as CategorySlug}
              label={data.title}
            />
          )
        }
      </div>

      <div class="bl-hero-scrim bl-hero-scrim-y" aria-hidden="true"></div>

      <div class="bl-hero-frame bl-hero-frame-bottom">
        <div class="bl-container w-full">
          <div class="bl-hero-body max-w-4xl flex flex-col gap-4 md:gap-6">
            <div class="flex flex-wrap items-center gap-3">
              <a href={catPath} class="bl-badge bl-badge-accent">{catName}</a>
              <span class="bl-label-sm bl-hero-subtle">{copy.post.readingTime(minutes)}</span>
            </div>

            <h1 class="bl-display">{data.title}</h1>

            <div class="flex flex-wrap items-center gap-5 md:gap-6 md:mt-2">
              <div class="flex items-center gap-3">
                <img
                  src="/images/avatar.png"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="w-10 h-10 md:w-12 md:h-12 rounded-full object-cover"
                  style="border: 1px solid rgba(127,127,127,0.3);"
                />
                <div>
                  <p class="bl-label !tracking-normal !normal-case" style="color: var(--hero-fg);">
                    {data.author}
                  </p>
                  <p class="text-[12px] leading-4 bl-hero-subtle">{authorRole}</p>
                </div>
              </div>

              <div class="hidden md:block bl-divider-v h-10"></div>

              <div class="bl-hero-subtle">
                <p class="bl-label !tracking-normal !normal-case">
                  <time datetime={data.publishDate.toISOString()}>
                    {formatDate(data.publishDate, lang)}
                  </time>
                </p>
                {
                  data.updatedDate && (
                    <p class="text-[12px] leading-4">
                      {copy.post.updated}{' '}
                      <time datetime={data.updatedDate.toISOString()}>
                        {formatDate(data.updatedDate, lang)}
                      </time>
                    </p>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* ══════════════ Top ad ══════════════ */}
    <div class="bl-container pt-10 md:pt-14">
      <AdSlot slot="articleTop" lang={lang} variant="leaderboard" />
    </div>

    {/* ══════════════ Body + sidebar ══════════════ */}
    <div class="bl-container py-12 md:py-16 lg:py-20">
      <div class="grid grid-cols-12 gap-x-6 gap-y-16">
        {/* ── Body ── */}
        <div data-article-body class="col-span-12 lg:col-span-8 min-w-0">
          <p
            class="bl-body-lg italic mb-12"
            style="border-left: 4px solid var(--bl-accent); padding-left: 28px; color: var(--bl-ink-70);"
          >
            {data.description}
          </p>

          {
            toc.length > 1 && (
              <details
                class="mb-12 p-5 sm:p-6"
                style="border: 1px solid var(--bl-sand); border-radius: var(--bl-r-md);"
                open
              >
                <summary class="cursor-pointer bl-label" style="color: var(--bl-ink);">
                  {copy.sections.toc}
                </summary>
                <div class="mt-5">
                  <TableOfContents lang={lang} headings={toc} />
                </div>
              </details>
            )
          }

          <div class="bl-prose">
            <Content />
          </div>

          {/* Share + tags */}
          <div class="mt-14 pt-8 bl-rule !border-b-0" style="border-top: 1px solid var(--bl-sand);">
            <ShareBar lang={lang} url={url} title={data.title} />

            {
              data.tags.length > 0 && (
                <div class="mt-6 flex flex-wrap items-center gap-2">
                  <span class="bl-label-sm mr-1" style="color: var(--bl-ink-40);">
                    {copy.post.tags}
                  </span>
                  {data.tags.map((tag) => (
                    <span class="bl-tag">{tag}</span>
                  ))}
                </div>
              )
            }
          </div>

          <div class="mt-12">
            <AdSlot slot="articleInline" lang={lang} variant="in-article" />
          </div>

          <div class="mt-12">
            <ArticleCTA lang={lang} relatedProject={data.relatedProject} />
          </div>

          {/* Prev / next */}
          {
            (prev || next) && (
              <nav
                class="mt-12 grid gap-px sm:grid-cols-2"
                style="background: var(--bl-sand);"
                aria-label={lang === 'id' ? 'Navigasi artikel' : 'Article navigation'}
              >
                {prev ? (
                  <a
                    href={routes.post(lang, prev.data.slug)}
                    class="group flex flex-col gap-2 p-6"
                    style="background: var(--bl-bone);"
                  >
                    <span class="inline-flex items-center gap-2 bl-label-sm" style="color: var(--bl-ink-40);">
                      <Icon name="arrow-left" size={13} stroke={2.5} />
                      {copy.post.prev}
                    </span>
                    <span class="bl-card-title font-display font-medium text-[16px] leading-snug">
                      {prev.data.title}
                    </span>
                  </a>
                ) : (
                  <span style="background: var(--bl-bone);" />
                )}
                {next && (
                  <a
                    href={routes.post(lang, next.data.slug)}
                    class="group flex flex-col gap-2 p-6 sm:items-end sm:text-right"
                    style="background: var(--bl-bone);"
                  >
                    <span class="inline-flex items-center gap-2 bl-label-sm" style="color: var(--bl-ink-40);">
                      {copy.post.next}
                      <Icon name="arrow-right" size={13} stroke={2.5} />
                    </span>
                    <span class="bl-card-title font-display font-medium text-[16px] leading-snug">
                      {next.data.title}
                    </span>
                  </a>
                )}
              </nav>
            )
          }
        </div>

        {/* ── Sidebar ── */}
        <aside class="col-span-12 lg:col-span-4 flex flex-col gap-14 lg:pl-4">
          <form method="get" action={routes.archive(lang)} role="search">
            <label class="sr-only" for="bl-side-search">{copy.hero.searchPlaceholder}</label>
            <div class="relative">
              <input
                id="bl-side-search"
                name="q"
                type="search"
                placeholder={copy.hero.searchPlaceholder}
                class="bl-input-line pr-8"
              />
              <span class="absolute right-0 top-3" style="color: var(--bl-ink-40);">
                <Icon name="search" size={17} />
              </span>
            </div>
          </form>

          {
            latest.length > 0 && (
              <div>
                <h2 class="bl-headline-md pb-4 bl-rule">{copy.sections.latest}</h2>
                <div class="mt-6 flex flex-col gap-6">
                  {latest.map((p) => (
                    <PostCard post={p} lang={lang} variant="compact" headingLevel={3} />
                  ))}
                </div>
              </div>
            )
          }

          <div>
            <h2 class="bl-headline-md pb-4 bl-rule">{copy.footer.categories}</h2>
            <div class="mt-6 flex flex-wrap gap-2">
              {
                blogCategories.map((c) => (
                  <a
                    href={routes.category(lang, c.slug)}
                    class="bl-filter !normal-case !tracking-normal !text-[13px] !px-4 !py-2"
                    aria-current={c.slug === data.category ? 'page' : undefined}
                  >
                    {c.label[lang]} ({counts.get(c.slug) ?? 0})
                  </a>
                ))
              }
            </div>
          </div>

          <Newsletter lang={lang} variant="bento" />

          <AdSlot slot="sidebar" lang={lang} variant="sidebar" class="hidden lg:flex" />
        </aside>
      </div>
    </div>
  </article>

  {/* ══════════════ Related ══════════════ */}
  {
    related.length > 0 && (
      <section class="bl-band-alt" aria-labelledby="bl-related">
        <div class="bl-container py-14 md:py-20 lg:py-24">
          <div class="flex items-end justify-between gap-6 mb-10">
            <div>
              <h2 id="bl-related" class="bl-headline-lg">
                {copy.sections.related}
              </h2>
              <p class="mt-2 bl-body" style="color: var(--bl-ink-60);">
                {copy.sections.relatedSub}
              </p>
            </div>
            <a href={routes.home(lang)} class="hidden sm:inline-flex bl-more bl-more-accent shrink-0">
              {copy.common.viewAll}
              <Icon name="arrow-right" size={15} stroke={2.5} />
            </a>
          </div>

          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 md:gap-x-6">
            {related.map((p) => (
              <PostCard post={p} lang={lang} variant="grid" headingLevel={3} />
            ))}
          </div>

          <div class="mt-12">
            <AdSlot slot="articleBottom" lang={lang} variant="leaderboard" />
          </div>

          <div class="mt-10">
            <a href={routes.home(lang)} class="inline-flex items-center gap-2 bl-more">
              <Icon name="arrow-left" size={15} stroke={2.5} />
              {copy.post.backToBlog}
            </a>
          </div>
        </div>
      </section>
    )
  }
</BlogLayout>
