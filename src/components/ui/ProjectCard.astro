---
interface Props {
  index: number;
  title: string;
  summary: string;
  tags: string[];
  year: number;
  url?: string;
  thumbnail?: string;
  video?: string;
}

const { index, title, summary, tags, year, url, thumbnail, video } = Astro.props;

const paddedIndex = index.toString().padStart(2, '0');
const isExternal = url && !url.startsWith('#') && !url.startsWith('/');
---

<article
  class="work-card group relative shrink-0 snap-start overflow-hidden rounded-3xl border border-[color:var(--color-border-light)]/50 w-[86vw] sm:w-[64vw] lg:w-[46vw] xl:w-[40vw] h-[62svh] lg:h-full"
>
  <!-- Media background (video wins over image) -->
  <div class="work-media absolute inset-0" aria-hidden="true">
    {
      video ? (
        <video
          src={video}
          poster={thumbnail}
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover"
        />
      ) : (
        <img
          src={thumbnail ?? '/images/projects/bintan-prestige.svg'}
          alt=""
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      )
    }
  </div>

  <!-- Bottom gradient so text stays readable -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"
  >
  </div>

  <!-- Top row: index + year badges left, tags right -->
  <div class="absolute top-5 inset-x-5 flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center rounded-full border border-white/15 bg-black/50 backdrop-blur px-3.5 py-1.5 text-xs font-mono text-[color:var(--color-accent)]">
        {paddedIndex}
      </span>
      <span class="inline-flex items-center rounded-full border border-white/15 bg-black/50 backdrop-blur px-3.5 py-1.5 text-xs text-[color:var(--color-text-muted)]">
        {year}
      </span>
    </div>
    <div class="flex flex-wrap justify-end gap-2 max-w-[60%]">
      {
        tags.map((tag) => (
          <span class="inline-flex items-center rounded-full border border-white/15 bg-black/50 backdrop-blur px-3.5 py-1.5 text-xs text-[color:var(--color-text)]">
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Bottom: title, summary, CTA -->
  <div class="absolute bottom-0 inset-x-0 p-6 lg:p-8 flex flex-col gap-3">
    <h3 class="font-display text-2xl lg:text-3xl font-bold text-white">
      {title}
    </h3>
    <p class="text-sm lg:text-base text-white/70 leading-relaxed max-w-xl line-clamp-2">
      {summary}
    </p>
    <div class="mt-2">
      <a
        href={url ?? '#cta'}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 backdrop-blur px-5 py-2.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] hover:text-[#0C0C0C]"
      >
        Read more
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="7" y1="17" x2="17" y2="7" />
          <polyline points="7 7 17 7 17 17" />
        </svg>
      </a>
    </div>
  </div>
</article>
