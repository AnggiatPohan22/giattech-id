---
import Button from './Button.astro';
import type { PricingPlan } from '../../data/pricing';

interface Props {
  plan: PricingPlan;
}

const { plan } = Astro.props;

const cardClasses = plan.featured
  ? 'relative border-[color:var(--color-accent)]/60 bg-[color:var(--color-surface-hover)]'
  : 'border-[color:var(--color-border)] bg-[color:var(--color-surface)] hover:border-[color:var(--color-border-light)]';
---

<article
  class={`group relative flex flex-col gap-6 h-full rounded-2xl border p-7 md:p-8 transition-all duration-300 ${cardClasses}`}
>
  {
    plan.featured && (
      <div class="absolute -top-3 left-1/2 -translate-x-1/2">
        <span class="inline-flex items-center rounded-full bg-[color:var(--color-accent)] px-3 py-1 text-xs font-semibold text-[#0C0C0C]">
          Most Popular
        </span>
      </div>
    )
  }

  <header class="flex flex-col gap-2">
    <h3 class="text-h3 font-display font-semibold text-[color:var(--color-text)]">
      {plan.name}
    </h3>
    <p class="text-sm text-[color:var(--color-text-muted)] min-h-[3rem]">
      {plan.tagline}
    </p>
  </header>

  <div class="flex items-baseline gap-1">
    <span class="font-display text-4xl md:text-5xl font-bold text-[color:var(--color-text)]">
      {plan.price}
    </span>
    {
      plan.priceSuffix && (
        <span class="text-sm text-[color:var(--color-text-subtle)]">
          {plan.priceSuffix}
        </span>
      )
    }
  </div>

  <div class="h-px w-full bg-[color:var(--color-border)]"></div>

  <ul class="flex flex-col gap-3">
    {
      plan.features.map((feature) => (
        <li class="flex items-start gap-3 text-sm text-[color:var(--color-text-muted)]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-0.5 shrink-0 text-[color:var(--color-accent)]"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto pt-2">
    <Button
      href={plan.cta.href}
      variant={plan.featured ? 'primary' : 'outline'}
      size="md"
      pill
      class="w-full"
    >
      {plan.cta.label}
    </Button>
  </div>
</article>
