---
import { navLinks, socialLinks } from '../../data/navigation';

const year = new Date().getFullYear();

type IconName = (typeof socialLinks)[number]['icon'];

const icons: Record<IconName, string> = {
  github:
    '<path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.83 0c2.22-1.49 3.2-1.18 3.2-1.18.63 1.59.23 2.77.11 3.06.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.27 5.69.41.35.77 1.04.77 2.1v3.11c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>',
  linkedin:
    '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.95v5.66H9.35V9h3.4v1.56h.05a3.73 3.73 0 0 1 3.36-1.85c3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>',
  twitter:
    '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>',
  email:
    '<path d="M3 4h18c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v.4l9 6.15L21 6.4V6H3zm18 2.94-8.44 5.77a1 1 0 0 1-1.12 0L3 8.94V18h18V8.94z"/>',
};
---

<footer
  data-theme="dark"
  class="border-t border-[color:var(--color-border)] mt-24 lg:pl-[356px]"
>
  <div class="container-page py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="lg:col-span-2 max-w-md">
        <a
          href="#hero"
          class="inline-block font-display text-2xl font-bold text-[color:var(--color-text)] hover:text-[color:var(--color-accent)] transition-colors"
        >
          Giattech
        </a>
        <p class="mt-4 text-[color:var(--color-text-muted)]">
          A web application studio building high-performance Laravel apps,
          admin platforms, and marketing sites from Indonesia — for teams
          who care how it actually runs.
        </p>
      </div>

      <div>
        <h3 class="text-eyebrow mb-4">Navigation</h3>
        <ul class="flex flex-col gap-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center py-1 text-sm text-[color:var(--color-text-muted)] hover:text-[color:var(--color-accent)] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-eyebrow mb-4">Contact</h3>
        <ul class="flex flex-col gap-3 text-sm text-[color:var(--color-text-muted)]">
          <li>
            <a
              href="mailto:hello@giattech.com"
              class="inline-flex items-center py-1 hover:text-[color:var(--color-accent)] transition-colors"
            >
              hello@giattech.com
            </a>
          </li>
          <li>Based in Indonesia (UTC+7)</li>
          <li>Available worldwide</li>
        </ul>

        <div class="mt-6 flex items-center gap-3">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                target={s.icon === 'email' ? undefined : '_blank'}
                rel={s.icon === 'email' ? undefined : 'noopener noreferrer'}
                aria-label={s.label}
                class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-[color:var(--color-border-light)] text-[color:var(--color-text-muted)] hover:text-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  set:html={icons[s.icon]}
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="mt-14 pt-8 border-t border-[color:var(--color-border)] flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-[color:var(--color-text-subtle)]"
    >
      <p>&copy; {year} Giattech. All rights reserved.</p>
      <p>Built with Astro, Tailwind, GSAP.</p>
    </div>
  </div>
</footer>
