---
import SectionHeader from '../ui/SectionHeader.astro';
import { about } from '../../data/about';

const shortYear = (year: string) => `'${year.slice(-2)}`;
---

<section
  id="about"
  data-section="about"
  data-theme="light"
  class="section-light relative section-y border-b border-[color:var(--color-border)] overflow-hidden lg:pl-[348px]"
>
  <div class="container-page">
    <SectionHeader
      eyebrow={about.eyebrow}
      heading={about.heading}
      subtitle={about.intro}
    />

    <div id="about-track" class="relative mt-16 md:mt-20">
      <!-- Connecting line, drawn as you scroll (decorative) -->
      <svg
        class="about-path hidden lg:block absolute inset-0 w-full h-full pointer-events-none"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M 8 0
             C 30 4, 78 4, 82 10
             C 86 16, 30 18, 22 26
             C 14 34, 70 34, 80 42
             C 90 50, 34 52, 24 60
             C 14 68, 72 70, 82 78
             C 92 86, 40 90, 30 100"
          fill="none"
          stroke="var(--color-accent)"
          stroke-opacity="0.55"
          stroke-width="2"
          vector-effect="non-scaling-stroke"
          stroke-linecap="round"
        />
        <g fill="var(--color-accent)">
          <circle class="about-dot" cx="82" cy="10" r="0.7" />
          <circle class="about-dot" cx="22" cy="26" r="0.7" />
          <circle class="about-dot" cx="80" cy="42" r="0.7" />
          <circle class="about-dot" cx="24" cy="60" r="0.7" />
          <circle class="about-dot" cx="82" cy="78" r="0.7" />
        </g>
      </svg>

      <ol class="relative flex flex-col gap-16 md:gap-24 lg:gap-32">
        {
          about.timeline.map((entry, i) => (
            <li
              x-data="{ expanded: false }"
              data-animate="fade-up"
              class={`w-full max-w-xl ${i % 2 === 0 ? 'lg:mr-auto lg:ml-[6%]' : 'lg:ml-auto lg:mr-[6%]'}`}
            >
              <article class="rounded-3xl border border-[color:var(--color-border-light)]/50 bg-[color:var(--color-surface)]/80 backdrop-blur-md p-7 md:p-9 transition-colors duration-300 hover:border-[color:var(--color-border-light)]">
                <span
                  aria-hidden="true"
                  class="font-display text-5xl md:text-6xl font-extrabold text-[color:var(--color-accent)] leading-none"
                >
                  {shortYear(entry.year)}
                </span>
                <span class="sr-only">{entry.year}</span>

                <h3 class="mt-5 text-h3 font-display font-semibold text-[color:var(--color-text)]">
                  {entry.title}
                </h3>

                <p class="mt-3 text-[color:var(--color-text-muted)] leading-relaxed">
                  {entry.short}
                </p>

                <div
                  x-show="expanded"
                  x-cloak
                  x-transition:enter="transition ease-out duration-300"
                  x-transition:enter-start="opacity-0 -translate-y-2"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  class="mt-4 pt-4 border-t border-[color:var(--color-border)] text-[color:var(--color-text-muted)] leading-relaxed"
                >
                  <p>{entry.full}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {entry.tags.map((tag) => (
                      <li class="inline-flex items-center rounded-full bg-[color:var(--color-accent-muted)] px-2.5 py-1 text-[0.7rem] text-[color:var(--color-accent)]">
                        {tag}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-6 flex items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <span
                      aria-hidden="true"
                      class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[color:var(--color-accent-muted)] font-display text-sm font-bold text-[color:var(--color-accent)]"
                    >
                      Gt
                    </span>
                    <div class="flex flex-col leading-tight">
                      <span class="text-sm font-medium text-[color:var(--color-text)]">{entry.handle}</span>
                      <span class="text-xs text-[color:var(--color-text-subtle)]">{entry.timeLabel}</span>
                    </div>
                  </div>

                  <button
                    type="button"
                    @click="expanded = !expanded"
                    x-bind:aria-expanded="expanded ? 'true' : 'false'"
                    class="inline-flex items-center rounded-full border border-[color:var(--color-border-light)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-text)] hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors"
                  >
                    <span x-text="expanded ? 'Show less' : 'Read more'">Read more</span>
                  </button>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
