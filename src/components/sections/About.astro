---
import SectionHeader from '../ui/SectionHeader.astro';
import { about } from '../../data/about';
---

<section
  id="about"
  data-section="about"
  class="relative section-y border-b border-[color:var(--color-border)]"
>
  <div class="container-page">
    <SectionHeader
      eyebrow={about.eyebrow}
      heading={about.heading}
      subtitle={about.intro}
    />

    <ol
      class="mt-16 relative flex flex-col gap-14 lg:gap-16 border-l border-[color:var(--color-border)] pl-6 md:pl-10"
    >
      {
        about.timeline.map((entry) => (
          <li
            class="relative"
            x-data="{ expanded: false }"
          >
            <span
              aria-hidden="true"
              class="absolute -left-[calc(1.5rem+5px)] md:-left-[calc(2.5rem+5px)] top-2 w-2.5 h-2.5 rounded-full bg-[color:var(--color-accent)] ring-4 ring-[color:var(--color-bg)]"
            />

            <div class="flex items-baseline gap-4 mb-3">
              <span class="font-display text-3xl md:text-4xl font-bold text-[color:var(--color-text-subtle)]">
                {entry.year}
              </span>
              <span class="text-xs text-[color:var(--color-text-subtle)]">
                <span class="text-[color:var(--color-accent)]">{entry.handle}</span>
                {' · '}{entry.timeLabel}
              </span>
            </div>

            <article
              class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 md:p-8 transition-colors duration-300 hover:border-[color:var(--color-border-light)]"
            >
              <h3 class="text-h3 font-display font-semibold text-[color:var(--color-text)]">
                {entry.title}
              </h3>

              <p class="mt-3 text-[color:var(--color-text-muted)]">
                {entry.short}
              </p>

              <div
                x-show="expanded"
                x-cloak
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 -translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
                class="mt-4 pt-4 border-t border-[color:var(--color-border)] text-[color:var(--color-text-muted)]"
              >
                {entry.full}
              </div>

              <div class="mt-5 flex items-center justify-between flex-wrap gap-3">
                <ul class="flex flex-wrap gap-2">
                  {entry.tags.map((tag) => (
                    <li class="inline-flex items-center rounded-full bg-[color:var(--color-accent-muted)] px-2.5 py-1 text-[0.7rem] text-[color:var(--color-accent)]">
                      {tag}
                    </li>
                  ))}
                </ul>

                <button
                  type="button"
                  @click="expanded = !expanded"
                  class="inline-flex items-center gap-1 text-sm font-medium text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-light)] transition-colors"
                  x-bind:aria-expanded="expanded ? 'true' : 'false'"
                >
                  <span x-text="expanded ? 'Show less' : 'Read more'">Read more</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300"
                    x-bind:class="expanded ? 'rotate-180' : ''"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
