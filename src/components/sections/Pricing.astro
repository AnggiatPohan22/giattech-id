---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { offerings } from '../../data/offerings';
import type { ServiceIcon } from '../../data/services';

const iconPaths: Record<ServiceIcon, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  layout:
    '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  plug: '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8z"/><path d="M12 17v5"/>',
  gauge:
    '<path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M3.34 19h17.32"/>',
  sparkle:
    '<path d="M12 3l1.9 4.4L18 9l-4.1 1.6L12 15l-1.9-4.4L6 9l4.1-1.6L12 3z"/><path d="M19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14z"/>',
  'life-buoy':
    '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>',
};
---

<section
  id="pricing"
  data-section="pricing"
  data-theme="dark"
  class="section-dark relative pt-14 pb-12 md:pt-16 md:pb-14 border-b border-[color:var(--color-border)] overflow-hidden lg:pl-[356px]"
>
  <div class="container-page">
    <SectionHeader
      eyebrow="Services"
      heading="What We Offer."
      subtitle="Four core services — pick one, mix them, or pass an entire project. Everything ships with clear scope, honest timelines, and post-launch support."
    />
  </div>

  <!-- Cards: horizontal snap-scroll on small screens, 4-col grid on lg+
       so every card is fully visible (no highlight-clip against the edge).
       Vertical padding on the track leaves room for the lift + glow. -->
  <div
    class="offer-track-wrap mt-10 md:mt-12"
    data-offer-track
  >
    <div
      class="offer-track flex lg:grid lg:grid-cols-2 2xl:grid-cols-4 gap-4 md:gap-5 items-stretch px-5 md:px-8 lg:px-8 overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none py-6 lg:py-8"
    >
      {
        offerings.map((offer, i) => (
          <article
            class="offer-card group shrink-0 snap-center lg:shrink flex flex-col gap-5 w-[82vw] sm:w-[52vw] md:w-[42vw] lg:w-auto rounded-2xl border border-[color:var(--color-border-light)]/60 bg-[color:var(--color-surface)] p-6"
            data-offer-index={i}
          >
            <div class="flex items-start gap-4">
              <span class="offer-icon inline-flex shrink-0 items-center justify-center w-12 h-12 rounded-xl bg-[color:var(--color-accent-muted)] text-[color:var(--color-accent)]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={iconPaths[offer.icon]}
                />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-xl md:text-2xl font-bold text-[color:var(--color-text)]">
                  {offer.title}
                </h3>
              </div>
            </div>

            <p class="text-[color:var(--color-text-muted)] leading-relaxed">
              {offer.tagline}
            </p>

            <ul class="flex flex-col gap-2 mt-auto pt-2">
              {offer.bullets.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-[color:var(--color-text-muted)]">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0 text-[color:var(--color-accent)]"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>

  <div class="container-page mt-12 md:mt-14 flex flex-wrap items-center justify-center gap-3 text-center">
    <p class="text-sm text-[color:var(--color-text-muted)]">
      Bundle two or more? Talk to us about a discounted retainer.
    </p>
    <Button href="#cta" variant="primary" size="md" pill>
      Book a Call
    </Button>
  </div>
</section>

<style>
  /* Hide native scrollbar on the offer track (swipe/scroll still works) */
  .offer-track { scrollbar-width: none; }
  .offer-track::-webkit-scrollbar { display: none; }

  /* Base card resting state — use `translate`/`scale` (individual CSS
     properties) instead of the `transform` shorthand so Tailwind's
     transform reset doesn't wipe out our highlight lift. */
  .offer-card {
    transition:
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      background-color 0.35s ease,
      box-shadow 0.45s ease,
      opacity 0.35s ease;
    will-change: translate, scale;
  }

  /* Non-highlighted cards fade back a touch so the active one pops */
  .offer-track[data-has-active] .offer-card:not(.is-active) {
    opacity: 0.55;
  }

  /* Highlighted card — hover OR scroll-centered */
  .offer-card.is-active,
  .offer-card:hover {
    translate: 0 -6px;
    scale: 1.02;
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
    background-color: var(--color-surface-hover);
    box-shadow:
      0 20px 40px -20px color-mix(in oklab, var(--color-accent) 40%, transparent),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 25%, transparent) inset;
    opacity: 1;
  }

  .offer-card.is-active .offer-icon,
  .offer-card:hover .offer-icon {
    scale: 1.08;
    rotate: -3deg;
    transition:
      scale 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      rotate 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Reduced motion is honored globally by the .01ms transition-duration
     reset in global.css — no local override needed. */
</style>

<script>
  // Highlight the card centered in the viewport as the user scrolls.
  // Works for horizontal (swipe/track) and vertical (page) scroll.
  const wraps = document.querySelectorAll<HTMLElement>('[data-offer-track]');
  wraps.forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.offer-track');
    if (!track) return;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.offer-card'));
    if (!cards.length) return;

    const setActive = (target: HTMLElement | null) => {
      cards.forEach((c) => c.classList.toggle('is-active', c === target));
      if (target) {
        track.setAttribute('data-has-active', '');
      } else {
        track.removeAttribute('data-has-active');
      }
    };

    // Pick the card closest to the viewport center (horizontal + vertical).
    const pickCentered = () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      let best: HTMLElement | null = null;
      let bestDist = Infinity;
      for (const card of cards) {
        const r = card.getBoundingClientRect();
        if (r.right < 0 || r.left > vw || r.bottom < 0 || r.top > vh) continue;
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = cx - vw / 2;
        const dy = cy - vh / 2;
        const d = Math.hypot(dx, dy);
        if (d < bestDist) {
          bestDist = d;
          best = card;
        }
      }
      // Only auto-highlight when the section is roughly in view
      const sectionRect = wrap.getBoundingClientRect();
      const inView = sectionRect.top < vh * 0.75 && sectionRect.bottom > vh * 0.15;
      setActive(inView ? best : null);
    };

    let raf = 0;
    const schedule = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        pickCentered();
      });
    };

    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    // Hover on any card temporarily takes over — clear track auto-active so
    // the CSS :hover state alone drives the highlight, then restore on leave.
    cards.forEach((card) => {
      card.addEventListener('pointerenter', () => setActive(card));
      card.addEventListener('pointerleave', () => schedule());
    });

    schedule();
  });
</script>
