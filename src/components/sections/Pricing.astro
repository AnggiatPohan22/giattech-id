---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { offerings } from '../../data/offerings';
import type { ServiceIcon } from '../../data/services';

const iconPaths: Record<ServiceIcon, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  layout:
    '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  plug: '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8z"/><path d="M12 17v5"/>',
  gauge:
    '<path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M3.34 19h17.32"/>',
  sparkle:
    '<path d="M12 3l1.9 4.4L18 9l-4.1 1.6L12 15l-1.9-4.4L6 9l4.1-1.6L12 3z"/><path d="M19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14z"/>',
  'life-buoy':
    '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>',
};
---

<section
  id="pricing"
  data-section="pricing"
  data-theme="dark"
  class="section-dark relative section-y border-b border-[color:var(--color-border)] lg:pl-[356px]"
>
  <div class="container-page">
    <SectionHeader
      eyebrow="Services"
      heading="What We Offer."
      subtitle="Four core services — pick one, mix them, or pass an entire project. Everything ships with clear scope, honest timelines, and post-launch support."
    />

    <div
      class="mt-14 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6"
      data-animate="stagger"
    >
      {
        offerings.map((offer) => (
          <article class="group flex flex-col gap-5 rounded-2xl border border-[color:var(--color-border-light)]/60 bg-[color:var(--color-surface)] p-6 md:p-8 transition-colors duration-300 hover:border-[color:var(--color-accent)]/40 hover:bg-[color:var(--color-surface-hover)]">
            <div class="flex items-start gap-4">
              <span class="inline-flex shrink-0 items-center justify-center w-12 h-12 rounded-xl bg-[color:var(--color-accent-muted)] text-[color:var(--color-accent)] transition-transform duration-300 group-hover:scale-105">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={iconPaths[offer.icon]}
                />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-xl md:text-2xl font-bold text-[color:var(--color-text)]">
                  {offer.title}
                </h3>
              </div>
            </div>

            <p class="text-[color:var(--color-text-muted)] leading-relaxed">
              {offer.tagline}
            </p>

            <ul class="flex flex-col gap-2 mt-auto">
              {offer.bullets.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-[color:var(--color-text-muted)]">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0 text-[color:var(--color-accent)]"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-12 md:mt-14 flex flex-wrap items-center justify-center gap-3 text-center">
      <p class="text-sm text-[color:var(--color-text-muted)]">
        Bundle two or more? Talk to us about a discounted retainer.
      </p>
      <Button href="#cta" variant="primary" size="md" pill>
        Book a Call
      </Button>
    </div>
  </div>
</section>
