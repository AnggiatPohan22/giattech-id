---
import { sidebarNav, sidebarStats, sidebarClients } from '../../data/sidebar';
import { sidebarSections, socialLinks } from '../../data/navigation';
import { contact } from '../../config/site';

const socialIcons: Record<string, string> = {
  linkedin:
    '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.95v5.66H9.35V9h3.4v1.56h.05a3.73 3.73 0 0 1 3.36-1.85c3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>',
  twitter:
    '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>',
  whatsapp:
    '<path d="M20.52 3.48A11.94 11.94 0 0 0 12 0C5.37 0 .01 5.37.01 12c0 2.12.55 4.15 1.6 5.96L0 24l6.24-1.6A11.94 11.94 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.19-1.24-6.19-3.48-8.52zM12 21.82c-1.87 0-3.7-.5-5.3-1.44l-.38-.22-3.7.95.99-3.6-.25-.4A9.83 9.83 0 0 1 2.18 12c0-5.42 4.4-9.82 9.82-9.82 2.62 0 5.09 1.02 6.94 2.88a9.75 9.75 0 0 1 2.88 6.94c0 5.42-4.4 9.82-9.82 9.82zm5.42-7.33c-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15s-.78.98-.96 1.18c-.18.2-.35.22-.65.08-.3-.15-1.28-.47-2.44-1.5-.9-.8-1.5-1.8-1.67-2.1-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.5-.5-.68-.5l-.58-.01c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.13 3.25 5.15 4.55.72.31 1.28.5 1.72.63.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35z"/>',
  instagram:
    '<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.4 2.23.06 1.27.08 1.65.08 4.85s-.02 3.58-.08 4.85c-.05 1.17-.24 1.8-.4 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.4-1.27.06-1.65.08-4.85.08s-3.58-.02-4.85-.08c-1.17-.05-1.8-.24-2.23-.4a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.4-2.23-.06-1.27-.08-1.65-.08-4.85s.02-3.58.08-4.85c.05-1.17.25-1.8.4-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.4 1.27-.06 1.65-.08 4.85-.08zm0-2.16C8.74 0 8.33.01 7.05.07 5.78.13 4.9.32 4.14.61c-.79.3-1.46.72-2.13 1.39A5.86 5.86 0 0 0 .61 4.14C.32 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.25 2.15.54 2.91.3.79.72 1.46 1.39 2.13a5.86 5.86 0 0 0 2.13 1.39c.76.3 1.64.48 2.91.54C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.25 2.91-.54.79-.3 1.46-.72 2.13-1.39a5.86 5.86 0 0 0 1.39-2.13c.3-.76.48-1.64.54-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.25-2.15-.54-2.91-.3-.79-.72-1.46-1.39-2.13A5.86 5.86 0 0 0 19.86.61C19.1.32 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/>',
};

// Sidebar top-right icon chips: keep to a compact set. Twitter + LinkedIn
// are the classic pair; WhatsApp is added when configured because
// businesses in Indonesia use it as the primary contact channel.
const socials = socialLinks.filter((s) => s.icon in socialIcons);
const sectionsJson = JSON.stringify(sidebarSections);
const clientsLoop = [...sidebarClients, ...sidebarClients];
---

<aside
  id="sidebar"
  x-data={`{
    mode: 'light',
    active: 'hero',
    sections: ${sectionsJson},
    copied: false,
    copyEmail() {
      navigator.clipboard?.writeText('${contact.email}');
      this.copied = true;
      setTimeout(() => this.copied = false, 2000);
    }
  }`}
  x-init="$el.dataset.ready = '1'"
  x-bind:data-mode="mode"
  data-mode="light"
  style="opacity:0; visibility:hidden; transform:translateX(-16px)"
  class="site-sidebar sidebar hidden lg:flex fixed left-10 top-5 bottom-5 w-[292px] z-40 flex-col gap-2 overflow-y-auto"
  aria-label="Site sidebar"
>
  <!-- BLOK 1 — Brand -->
  <div class="sb-card p-4" data-sb-observe data-sb-mode="light">
    <div class="flex items-start justify-between gap-3">
      <a href="#hero" class="sb-logo-badge">
        GIATTECH<sup class="text-[9px] ml-0.5">®</sup>
      </a>
      <div class="flex gap-2 shrink-0">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="sb-icon-btn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={socialIcons[s.icon]} />
            </a>
          ))
        }
      </div>
    </div>
    <p class="sb-tagline mt-3">
      Working closely with your team to deliver web builds, IT support and villa OTA management.
    </p>
  </div>

  <!-- BLOK 2 — Stats (with Giattech logo above 80+) -->
  <div class="sb-card px-4 py-3" data-sb-observe data-sb-mode="light">
    <div class="flex items-center justify-around">
      <div class="text-center">
        <img src="/images/logo-white.png" alt="Giattech" class="sb-stat-logo" width="22" height="22" />
        <div class="sb-stat-number">
          <span data-counter data-target={sidebarStats[0].value}>{sidebarStats[0].value}</span>{sidebarStats[0].suffix}
        </div>
        <div class="sb-stat-label" set:html={sidebarStats[0].label} />
      </div>
      <div class="sb-divider"></div>
      <div class="text-center pt-[26px]">
        <div class="sb-stat-number">
          <span data-counter data-target={sidebarStats[1].value}>{sidebarStats[1].value}</span>{sidebarStats[1].suffix}
        </div>
        <div class="sb-stat-label" set:html={sidebarStats[1].label} />
      </div>
    </div>
  </div>

  <!-- BLOK 3 — Navigation (pills hug their content) -->
  <nav
    class="sb-card p-2 flex flex-col items-start gap-1"
    aria-label="Section navigation"
    data-sb-observe
    data-sb-mode="light"
  >
    {
      sidebarNav.map((item) => (
        <a
          href={`#${item.id}`}
          class="sb-nav-item"
          x-bind:class={`active === '${item.id}' ? 'sb-nav-active' : ''`}
        >
          <span class="sb-nav-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          </span>
          <span>{item.label}</span>
        </a>
      ))
    }
  </nav>

  <!-- BLOK 4 — Client marquee (no card) -->
  <div class="sb-marquee" data-sb-observe data-sb-mode="light">
    <div class="sb-marquee-track">
      {clientsLoop.map((c) => <span class="sb-marquee-item">{c}</span>)}
    </div>
  </div>

  <!-- BLOK 5 — Contact (each control is its own observed box so the
       email pill and CTA can pick up different backgrounds if the sidebar
       ever straddles a section boundary at the bottom) -->
  <div class="mt-auto flex flex-col gap-2">
    <button
      type="button"
      @click="copyEmail()"
      class="sb-email-pill"
      aria-label="Copy email address"
      data-sb-observe
      data-sb-mode="light"
    >
      <span x-text={`copied ? 'Copied!' : '${contact.email}'`}>{contact.email}</span>
      <span class="inline-flex shrink-0">
        <svg x-show="!copied" xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <svg x-show="copied" x-cloak xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </span>
    </button>

    <a href="#cta" class="sb-cta" data-sb-observe data-sb-mode="light">Book a Call</a>
  </div>
</aside>
