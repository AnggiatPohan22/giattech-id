---
import Button from '../ui/Button.astro';
import { navLinks, primaryCta } from '../../data/navigation';
---

<header
  x-data="{
    scrolled: false,
    mobileOpen: false,
    theme: 'light',
    updateTheme() {
      const probe = 40;
      const sections = document.querySelectorAll('[data-theme]');
      let match = null;
      for (const el of sections) {
        const r = el.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) { match = el; break; }
      }
      if (!match) {
        for (const el of sections) {
          if (el.getBoundingClientRect().top <= probe) match = el;
        }
      }
      const t = match && match.getAttribute('data-theme');
      if (t && this.theme !== t) this.theme = t;
    }
  }"
  x-init="updateTheme();
          scrolled = window.scrollY > 50;
          const onScroll = () => { scrolled = window.scrollY > 50; updateTheme(); };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          window.addEventListener('hashchange', () => mobileOpen = false);
          $watch('mobileOpen', v => document.body.style.overflow = v ? 'hidden' : '')"
  x-bind:data-nav-theme="theme"
  x-bind:class="scrolled || mobileOpen ? 'nav-solid' : 'nav-glass'"
  class="nav-shell lg:hidden fixed top-0 inset-x-0 z-50 transition-colors duration-300"
>
  <div class="relative z-50 container-page flex items-center justify-between h-16 md:h-[var(--nav-height)]">
    <a
      href="#hero"
      class="inline-flex items-center gap-2 font-display text-[13px] md:text-2xl md:font-bold font-semibold tracking-[0.18em] md:tracking-tight uppercase md:normal-case text-[color:var(--color-text)] hover:text-[color:var(--color-accent)] transition-colors"
      aria-label="Giattech home"
    >
      <span
        aria-hidden="true"
        class="md:hidden inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-accent)]"
      ></span>
      Giattech
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center py-2 text-sm font-medium text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)] transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <Button href={primaryCta.href} variant="primary" size="sm" pill>
        {primaryCta.label}
      </Button>
    </div>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-9 h-9 -mr-1 text-[color:var(--color-text)] transition-colors"
      aria-label="Toggle menu"
      x-bind:aria-expanded="mobileOpen ? 'true' : 'false'"
      @click="mobileOpen = !mobileOpen"
    >
      <!-- Minimalist 2-line hamburger — swaps to an X when open. -->
      <svg
        x-show="!mobileOpen"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="9" x2="20" y2="9"></line>
        <line x1="4" y1="15" x2="14" y2="15"></line>
      </svg>
      <svg
        x-show="mobileOpen"
        x-cloak
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Full-screen mobile menu overlay — teleported to <body> so the
       parent header's backdrop-filter doesn't create a containing block
       that would clamp our fixed inset-0 to the header's 64px height. -->
  <template x-teleport="body">
  <div
    x-bind:class="mobileOpen ? 'mobile-menu-open' : ''"
    x-bind:data-nav-theme="theme"
    class="md:hidden fixed inset-0 z-40 mobile-menu-overlay flex flex-col"
    id="mobile-menu"
  >
    <!-- Spacer for the navbar bar height so menu content never sits under it -->
    <div class="h-16 shrink-0" aria-hidden="true"></div>

    <nav
      aria-label="Mobile"
      class="container-page flex-1 min-h-0 flex flex-col justify-between py-8"
    >
      <ul class="flex flex-col">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                @click="mobileOpen = false"
                class="mobile-menu-link block text-2xl font-display font-semibold text-[color:var(--color-text)] hover:text-[color:var(--color-accent)] py-4 border-b border-[color:var(--color-border)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobile-menu-cta mt-8">
        <Button
          href={primaryCta.href}
          variant="primary"
          size="md"
          pill
          class="w-full"
        >
          {primaryCta.label}
        </Button>
        <p class="mt-4 text-center text-xs text-[color:var(--color-text-muted)]">
          Web dev · Freelance IT · Villa OTA
        </p>
      </div>
    </nav>
  </div>
  </template>
</header>
