---
import ServiceCard from '../ui/ServiceCard.astro';
import { services, servicesIntro } from '../../data/services';
import type { ServiceIcon } from '../../data/services';

const chipIcons: Record<ServiceIcon, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  layout:
    '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  plug: '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8z"/><path d="M12 17v5"/>',
  gauge:
    '<path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M3.34 19h17.32"/>',
  sparkle:
    '<path d="M12 3l1.9 4.4L18 9l-4.1 1.6L12 15l-1.9-4.4L6 9l4.1-1.6L12 3z"/>',
  'life-buoy':
    '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>',
};
---

<section
  id="services"
  data-section="services"
  data-theme="light"
  class="section-light relative border-b border-[color:var(--color-border)] lg:pl-[356px]"
>
  <!-- Compact intro: giant heading + pill + word-reveal paragraph
       (was min-h-100svh — now sized to content) -->
  <div class="flex flex-col items-center text-center gap-6 container-page pt-20 pb-10 md:pt-24 md:pb-12">
    <h2
      class="font-display font-extrabold leading-[0.98] tracking-[-0.03em] text-[clamp(2.8rem,8vw,6rem)]"
      data-animate="fade-up"
    >
      What You Get?
    </h2>

    <span class="inline-flex items-center rounded-full border border-[color:var(--color-border-light)] px-4 py-1.5 text-eyebrow">
      Capabilities Overview
    </span>

    <p
      class="max-w-5xl font-display font-semibold leading-snug text-[clamp(1.4rem,3.4vw,2.8rem)]"
      data-scrub-words
    >
      {
        servicesIntro.map((segment) =>
          segment.type === 'text' ? (
            segment.value
              .split(' ')
              .map((word) => <span class="scrub-word">{word} </span>)
          ) : (
            <span class="scrub-word inline-flex items-center justify-center align-middle mx-1 w-[1.6em] h-[1.1em] rounded-xl bg-[color:var(--color-accent-muted)] text-[color:var(--color-accent)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="0.7em"
                height="0.7em"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={chipIcons[segment.value]}
              />
            </span>
          )
        )
      }
    </p>
  </div>

  <!-- Capability cards -->
  <div class="container-page pb-16 lg:pb-24">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6"
      data-animate="stagger"
    >
      {
        services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
          />
        ))
      }
    </div>
  </div>
</section>
